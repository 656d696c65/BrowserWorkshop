{
    "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "useImportType": "off"
            },
            "suspicious": {
                "noExplicitAny": "off"
            },
            "correctness": {
                "noUnusedImports": "error"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "asNeeded",
            "trailingCommas": "all",
            "expand": "always"
        }
    },
    "files": {
        "includes": [
            "*.{js,mjs,cjs,ts,tsx,json,jsonc}",
            "packages/**/*.{js,mjs,cjs,ts,tsx,json,jsonc}",
            "!**/node_modules",
            "!**/build",
            "!**/dist",
            "!**/styled-system"
        ],
        "ignoreUnknown": true
    }
}
