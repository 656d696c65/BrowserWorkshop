{
    "version": "0.2.0",
    "name": "@browserworkshop/shared",
    "type": "module",
    "private": true,
    "scripts": {
        "prepare": "panda codegen",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@tabler/icons-react": "3.36.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-hook-form": "7.69.0",
        "react-imask": "7.6.1",
        "@tanstack/react-query": "5.90.12"
    },
    "devDependencies": {
        "@pandacss/dev": "1.7.1",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3",
        "typescript": "5.9.3"
    },
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./styled-system/css": {
            "source": "./styled-system/css/index.mjs",
            "types": "./styled-system/css/index.d.ts",
            "default": "./styled-system/css/index.mjs"
        },
        "./styled-system/tokens": {
            "source": "./styled-system/tokens/index.mjs",
            "types": "./styled-system/tokens/index.d.ts",
            "default": "./styled-system/tokens/index.mjs"
        },
        "./styled-system/patterns": {
            "source": "./styled-system/patterns/index.mjs",
            "types": "./styled-system/patterns/index.d.ts",
            "default": "./styled-system/patterns/index.mjs"
        }
    }
}
